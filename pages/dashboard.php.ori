<!-- Scripts for Charts -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Project Status Chart (Doughnut)
    const statusCtx = document.getElementById('projectStatusChart');
    if (statusCtx) {
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: <?= json_encode(array_column(PROJECT_STATUS, 'label')) ?>,
                datasets: [{
                    data: <?= json_encode(array_values($statusDistribution)) ?>,
                    backgroundColor: <?= json_encode(array_column(PROJECT_STATUS, 'color')) ?>,
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '75%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e3a5f',
                        padding: 10,
                        cornerRadius: 8,
                        displayColors: true,
                        callbacks: {
                            label: function(context) {
                                return ' ' + context.label + ': ' + context.raw + ' Project';
                            }
                        }
                    }
                }
            }
        });
    }
});
</script>