<?php
if (!defined('BASE_URL')) {
    require_once __DIR__ . '/../config/session.php';
    require_once __DIR__ . '/../includes/functions.php';
    requireLogin();
}

$currentUser = getCurrentUser();
$pageTitle = 'Overview Console';

// 1. Get Base Data
$stats = getDashboardStats($currentUser['id']);
$allProjects = getProjectsForUser($currentUser['id']);
$ongoingTasks = getOngoingTasks($currentUser['id'], 8);

// 2. Calculate Completion Percentage
$totalCompletion = 0;
if ($stats['total_projects'] > 0) {
    $totalCompletion = round(($stats['completed_projects'] / $stats['total_projects']) * 100, 1);
}

// 3. Process Status Distribution for Chart
$statusDistribution = [];
foreach (PROJECT_STATUS as $key => $val) {
    $statusDistribution[$key] = 0;
}
$ongoingProjects = [];
foreach ($allProjects as $p) {
    if (isset($statusDistribution[$p['status']])) {
        $statusDistribution[$p['status']]++;
    }
    if (in_array($p['status'], ['active', 'on_hold'])) {
        $ongoingProjects[] = $p;
    }
}
$ongoingProjects = array_slice($ongoingProjects, 0, 6); // Ambil 6 project aktif terbaru

// 4. Process Deadlines for Current Month
$currentMonth = date('m');
$currentYear = date('Y');
$deadlinesThisMonth = array_filter($allProjects, function($p) use ($currentMonth, $currentYear) {
    if (empty($p['target_end_date'])) return false;
    $time = strtotime($p['target_end_date']);
    return date('m', $time) === $currentMonth 
        && date('Y', $time) === $currentYear 
        && !in_array($p['status'], ['completed', 'cancelled']); // Jangan tampilkan yang sudah selesai/batal
});

// Sort deadlines by date ascending (terdekat di atas)
usort($deadlinesThisMonth, function($a, $b) {
    return strtotime($a['target_end_date']) - strtotime($b['target_end_date']);
});

// 5. Get Task Activity (Last 7 Days)
$activityData = [];
$activityLabels = [];
$pmDb = db();
for ($i = 6; $i >= 0; $i--) {
    $date = date('Y-m-d', strtotime("-$i days"));
    $activityLabels[] = date('d M', strtotime($date));
    
    $stmt = $pmDb->prepare("
        SELECT COUNT(*) as total FROM task_status_history tsh
        INNER JOIN tasks t ON tsh.task_id = t.id
        WHERE DATE(tsh.changed_at) = ? AND (tsh.changed_by = ? OR t.assigned_to = ?)
    ");
    $stmt->execute([$date, $currentUser['id'], $currentUser['id']]);
    $activityData[] = (int)$stmt->fetch()['total'];
}
?>

